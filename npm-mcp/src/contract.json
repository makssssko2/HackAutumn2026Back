    {
      "name": "get_budget",
      "description": "Get a yearly/monthly budget per currency. Persists missing forecast periods;\n        does not release them to notification channels. Unavailable in read-only mode.\n        ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "year": {
            "maximum": 2100,
            "minimum": 2000,
            "title": "Year",
            "type": "integer"
          }
        },
        "required": [
          "year"
        ],
        "title": "get_budgetArguments"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "get_budgetDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "create_one_time_payment",
      "description": "Admin: create a single demo invoice. Amount is decimal; dates are ISO.\n        May queue notifications. Empty group_ids broadcasts to all active configured\n        channels. Not idempotent: inspect state before retrying an uncertain result.\n        ",
      "inputSchema": {
        "type": "object",
        "$defs": {
          "OneTimeIn": {
            "properties": {
              "title": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Title",
                "type": "string"
              },
              "description": {
                "default": "",
                "maxLength": 2000,
                "title": "Description",
                "type": "string"
              },
              "amount": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0.0,
                    "type": "number"
                  },
                  {
                    "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
                    "type": "string"
                  }
                ],
                "title": "Amount"
              },
              "currency": {
                "enum": [
                  "RUB",
                  "USD",
                  "EUR"
                ],
                "title": "Currency",
                "type": "string"
              },
              "due_date": {
                "format": "date",
                "title": "Due Date",
                "type": "string"
              },
              "group_ids": {
                "items": {
                  "type": "string"
                },
                "maxItems": 100,
                "title": "Group Ids",
                "type": "array"
              }
            },
            "required": [
              "title",
              "amount",
              "currency",
              "due_date"
            ],
            "title": "OneTimeIn",
            "type": "object"
          }
        },
        "properties": {
          "payment": {
            "$ref": "#/$defs/OneTimeIn"
          }
        },
        "required": [
          "payment"
        ],
        "title": "create_one_time_paymentArguments"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "create_one_time_paymentDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "create_recurring_payment",
      "description": "Admin: create recurring demo invoices. Each period is independent.\n        May queue notifications. Empty group_ids means all active configured channels.\n        Not idempotent: inspect state before retrying an uncertain result.\n        ",
      "inputSchema": {
        "type": "object",
        "$defs": {
          "RecurringIn": {
            "properties": {
              "title": {
                "maxLength": 200,
                "minLength": 1,
                "title": "Title",
                "type": "string"
              },
              "description": {
                "default": "",
                "maxLength": 2000,
                "title": "Description",
                "type": "string"
              },
              "amount": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0.0,
                    "type": "number"
                  },
                  {
                    "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,15}0*$)\\d{0,12}\\.\\d{0,2}0*$)",
                    "type": "string"
                  }
                ],
                "title": "Amount"
              },
              "currency": {
                "enum": [
                  "RUB",
                  "USD",
                  "EUR"
                ],
                "title": "Currency",
                "type": "string"
              },
              "first_due_date": {
                "format": "date",
                "title": "First Due Date",
                "type": "string"
              },
              "frequency": {
                "default": "monthly",
                "enum": [
                  "monthly",
                  "quarterly",
                  "yearly",
                  "weekly"
                ],
                "title": "Frequency",
                "type": "string"
              },
              "group_ids": {
                "items": {
                  "type": "string"
                },
                "maxItems": 100,
                "title": "Group Ids",
                "type": "array"
              }
            },
            "required": [
              "title",
              "amount",
              "currency",
              "first_due_date"
            ],
            "title": "RecurringIn",
            "type": "object"
          }
        },
        "properties": {
          "payment": {
            "$ref": "#/$defs/RecurringIn"
          }
        },
        "required": [
          "payment"
        ],
        "title": "create_recurring_paymentArguments"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "create_recurring_paymentDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "set_invoice_payment",
      "description": "Confirm/correct/undo DEMONSTRATION payment; no real money moves.\n        Read get_invoice for expected_revision first. paid_at is an actual date,\n        not a due date, and cannot be in the future. paid=false clears payment and\n        voids its receipt. May queue receipt/status notifications. Do not replay a 409.\n        ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "occurrence_id": {
            "format": "uuid",
            "title": "Occurrence Id",
            "type": "string"
          },
          "paid": {
            "title": "Paid",
            "type": "boolean"
          },
          "expected_revision": {
            "minimum": 0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "paid_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Paid At"
          }
        },
        "required": [
          "occurrence_id",
          "paid",
          "expected_revision"
        ],
        "title": "set_invoice_paymentArguments"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "set_invoice_paymentDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "stop_recurring_payment",
      "description": "Admin: stop a recurring template. Cancels unpaid current/future periods,\n        preserves old debts and history, and may queue cancellation notifications.\n        Use the template's payment_id, not an occurrence ID.\n        ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "payment_id": {
            "format": "uuid",
            "title": "Payment Id",
            "type": "string"
          }
        },
        "required": [
          "payment_id"
        ],
        "title": "stop_recurring_paymentArguments"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "stop_recurring_paymentDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "cancel_one_time_payment",
      "description": "Admin: cancel an unpaid one-time invoice while preserving history.\n        May queue cancellation notifications. This is separate from undoing payment.\n        Use recurring_id from its period as payment_id.\n        ",
      "inputSchema": {
        "type": "object",
        "properties": {
          "payment_id": {
            "format": "uuid",
            "title": "Payment Id",
            "type": "string"
          }
        },
        "required": [
          "payment_id"
        ],
        "title": "cancel_one_time_paymentArguments"
      },
      "outputSchema": {
        "additionalProperties": true,
        "title": "cancel_one_time_paymentDictOutput",
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      }
    }
  ]
}
