APP_NAME=Invoice Keeper
DATABASE_URL=sqlite:///./data/invoice-keeper.db
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-before-use
APP_TIMEZONE=Europe/Moscow
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
# Set false to hide the profile password form and reject password changes via API.
PASSWORD_CHANGE_ENABLED=true
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_INVOICE_VIEW_ENABLED=false
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=invoice-keeper@localhost
SMTP_STARTTLS=true
SMTP_SSL=false
WORKER_INTERVAL_SECONDS=30
ALLOW_PRIVATE_WEBHOOKS=false
PUBLIC_APP_URL=http://localhost:8000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_ENCRYPTION_KEY=
B2B_ENABLED=false
B2B_API_KEY_PEPPER=
B2B_DOCUMENT_MAX_BYTES=10485760
B2B_DOCUMENT_MAX_FILES=5
B2B_DOCUMENT_MAX_TOTAL_BYTES=31457280
# Enable only with `docker compose --profile clamav up` and B2B_CLAMAV_HOST=clamav.
B2B_CLAMAV_ENABLED=false
B2B_CLAMAV_HOST=
B2B_CLAMAV_PORT=3310
B2B_IDEMPOTENCY_TTL_DAYS=7
